[Unit]
Description=Union Link Web
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=union-link
Group=union-link
WorkingDirectory=/opt/union-link/app
EnvironmentFile=/etc/union-link/common.env
EnvironmentFile=/etc/union-link/web.env
# Never start a runtime service with migration/administrator/Worker credentials.
UnsetEnvironment=DATABASE_ADMIN_URL DATABASE_MIGRATION_URL DATABASE_WORKER_URL
ExecStartPre=/usr/bin/node --conditions=react-server --import tsx scripts/check-deployment.ts --role web
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3001
Restart=on-failure
RestartSec=10
TimeoutStartSec=90
TimeoutStopSec=60
KillSignal=SIGTERM
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/union-link/app/.next /var/lib/union-link/tmp

[Install]
WantedBy=multi-user.target
