# Shared by Web, Worker and one-off deployment commands. Never put DB URLs here.
# Administrator copy: /etc/union-link/common.env (0600).
# Runtime copies: common-web.env / common-worker.env, separate groups, 0640.
# Set each TMPDIR to the matching service ReadWritePaths.
NODE_ENV="production"
APP_ORIGIN="https://link.example.com"
NEXT_TELEMETRY_DISABLED="1"
NEXT_DIST_DIR=".next"
OSS_PROVIDER="minio"
# Must be accessible by the server AND browsers/Launcher using HTTPS.
OSS_ENDPOINT="https://objects.example.com"
OSS_REGION="us-east-1"
OSS_ACCESS_KEY_ID="CHANGE_ME_STORAGE_ACCESS_KEY"
OSS_SECRET_ACCESS_KEY="CHANGE_ME_STORAGE_SECRET"
OSS_PACKAGES_BUCKET="union-link-packages"
OSS_CAS_BUCKET="union-link-cas"
OSS_ENVIRONMENTS_BUCKET="union-link-environments"
OSS_TELEMETRY_ENABLED="true"
# Optional backend-only metrics endpoint/token; do not expose credentials publicly.
# OSS_METRICS_ENDPOINT="http://127.0.0.1:9000"
# OSS_METRICS_BEARER_TOKEN="CHANGE_ME_READ_ONLY_METRICS_TOKEN"
# For aws/ali/tencent/huawei, see README.md for native regional settings.
SIGNING_PRIVATE_KEY_PATH="/var/lib/union-link/signing/ed25519.pem"
TMPDIR="/var/lib/union-link/tmp"
DOWNLOAD_DNS_OVER_HTTPS="false"
SERVER_PROBE_HIGH_LATENCY_MS="300"
