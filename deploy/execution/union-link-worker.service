[Unit]
Description=Union Link Worker
After=network-online.target docker.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=unionlink
Group=unionlink
SupplementaryGroups=docker
WorkingDirectory=/opt/union-link/app
EnvironmentFile=/etc/union-link/worker.env
Environment=NODE_ENV=production
Environment=DOTENV_CONFIG_PATH=/etc/union-link/worker.env
ExecStart=/usr/bin/node --conditions=react-server --import tsx scripts/client-worker.ts
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=120
UMask=0077

[Install]
WantedBy=multi-user.target
