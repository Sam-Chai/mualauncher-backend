<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>org.unionlink.worker</string>
  <key>UserName</key><string>unionlink</string><key>SessionCreate</key><true/>
  <key>ProgramArguments</key><array><string>/opt/homebrew/bin/node</string><string>--conditions=react-server</string><string>--import</string><string>tsx</string><string>scripts/client-worker.ts</string></array>
  <key>WorkingDirectory</key><string>/Users/unionlink/union-link</string>
  <key>EnvironmentVariables</key><dict><key>NODE_ENV</key><string>production</string><key>DOTENV_CONFIG_PATH</key><string>/Users/unionlink/.config/union-link/worker.env</string><key>HOME</key><string>/Users/unionlink</string><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>ExitTimeOut</key><integer>120</integer>
  <key>StandardOutPath</key><string>/Users/unionlink/Library/Logs/unionlink-worker.log</string>
  <key>StandardErrorPath</key><string>/Users/unionlink/Library/Logs/unionlink-worker-error.log</string>
</dict></plist>
