[Unit]
Description=Reap expired Union Link execution resources
After=docker.service

[Service]
Type=oneshot
User=unionlink
Group=unionlink
SupplementaryGroups=docker
WorkingDirectory=/opt/union-link/app
# Only SANDBOX_* settings here; never database, signing or storage credentials.
EnvironmentFile=/etc/union-link/sandbox.env
Environment=NODE_ENV=production
Environment=SANDBOX_ENV_FILE=/etc/union-link/sandbox.env
ExecStart=/usr/bin/node --conditions=react-server --import tsx scripts/execution-admin.ts reap
TimeoutStartSec=120
UMask=0077
