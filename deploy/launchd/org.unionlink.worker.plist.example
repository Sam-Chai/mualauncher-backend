<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>org.unionlink.worker</string>
<key>UserName</key><string>unionlink</string><key>SessionCreate</key><true/>
<key>ProgramArguments</key><array><string>/opt/homebrew/bin/node</string><string>scripts/service.mjs</string><string>worker</string><string>/Users/unionlink/.config/union-link/common.env</string><string>/Users/unionlink/.config/union-link/worker.env</string><string>/Users/unionlink/.config/union-link/sandbox.env</string></array>
<key>WorkingDirectory</key><string>/Users/unionlink/union-link</string>
<key>EnvironmentVariables</key><dict><key>HOME</key><string>/Users/unionlink</string><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
<key>RunAtLoad</key><true/>
<key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>10</integer>
<key>Umask</key><integer>63</integer><key>ExitTimeOut</key><integer>120</integer>
<key>StandardOutPath</key><string>/Users/unionlink/Library/Logs/unionlink-worker.log</string>
<key>StandardErrorPath</key><string>/Users/unionlink/Library/Logs/unionlink-worker-error.log</string>
</dict></plist>
