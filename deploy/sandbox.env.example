# Worker/reaper only. Never supply Docker access to Web.
# Use default on Linux; colima-union-link on native macOS.
SANDBOX_DOCKER_CONTEXT="default"
SANDBOX_DOCKER_BIN="/usr/bin/docker"
SANDBOX_NAMESPACE="union-link"
# Replace with the immutable identity printed by sandbox:image on THIS daemon.
SANDBOX_JAVA_IMAGE="CHANGE_ME_IMMUTABLE_IMAGE"
# Reviewed, native-architecture Node 24 / Temurin 21 JRE image digests:
SANDBOX_NODE_BASE="CHANGE_ME_NODE_IMAGE_AT_SHA256"
SANDBOX_JAVA_BASE="CHANGE_ME_JRE_IMAGE_AT_SHA256"
SANDBOX_SLOTS="1"
SANDBOX_MEMORY_MIB="6144"
SANDBOX_HEAP_MIB="2048"
SANDBOX_CPUS="2"
SANDBOX_WORKSPACE_MIB="2048"
SANDBOX_TMP_MIB="256"
SANDBOX_PIDS="256"
