# Only Web's three restricted DB connections. URL-encode special password characters.
# Install as /etc/union-link/web.env (root:union-link-web, mode 0640).
DATABASE_URL="postgresql://mua_web:CHANGE_ME_WEB_PASSWORD@127.0.0.1:5432/union_link"
DATABASE_AUTH_URL="postgresql://mua_auth:CHANGE_ME_AUTH_PASSWORD@127.0.0.1:5432/union_link"
DATABASE_PUBLIC_URL="postgresql://mua_public:CHANGE_ME_PUBLIC_PASSWORD@127.0.0.1:5432/union_link"

# Nginx must overwrite this single-IP header. No direct public Next.js access.
AUTH_CLIENT_IP_HEADER="x-unionlink-client-ip"
LAUNCHER_AUTH_CLIENT_IP_HEADER="x-unionlink-client-ip"

# Union skin-site sign-in: register APP_ORIGIN + /api/auth/union/callback upstream.
# Keep credentials on Web only; leave both unset until registered.
# UNION_OAUTH_CLIENT_ID="CHANGE_ME_REGISTERED_CLIENT_ID"
# UNION_OAUTH_CLIENT_SECRET="CHANGE_ME_OAUTH_SECRET"
# UNION_OAUTH_CLIENT_AUTH="post"
# UNION_OAUTH_SCOPE=""
