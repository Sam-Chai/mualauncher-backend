{
  "name": "mualauncher-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "node --conditions=react-server --import tsx scripts/check-db.ts",
    "db:provision": "node --import tsx scripts/provision-database-roles.ts",
    "db:deploy": "prisma migrate deploy",
    "auth:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-admin.ts",
    "muapack:validate": "node --conditions=react-server --import tsx scripts/validate-muapack.ts",
    "typecheck": "tsc --noEmit",
    "storage:init": "node --conditions=react-server --import tsx scripts/initialize-storage.ts",
    "storage:verify": "node --conditions=react-server --import tsx scripts/verify-storage.ts",
    "storage:telemetry": "node --conditions=react-server --import tsx scripts/collect-storage-telemetry.ts",
    "worker": "node --conditions=react-server --import tsx scripts/client-worker.ts",
    "client:upload": "node --import tsx scripts/upload-client.ts",
    "sandbox:check": "node --conditions=react-server --import tsx scripts/execution-admin.ts check",
    "sandbox:reap": "node --conditions=react-server --import tsx scripts/execution-admin.ts reap",
    "sandbox:image": "node --conditions=react-server --import tsx scripts/execution-admin.ts image",
    "sandbox:verify": "node --conditions=react-server --import tsx scripts/execution-admin.ts verify",
    "with-env": "node scripts/with-env.mjs",
    "deployment:check": "node --conditions=react-server --import tsx scripts/check-deployment.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "9.1.0",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@scalar/api-reference-react": "0.9.83",
    "@tanstack/react-table": "8.21.3",
    "ali-oss": "^6.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "crc-32": "^1.2.2",
    "dotenv": "18.0.6",
    "esdk-obs-nodejs": "^3.26.2",
    "jose": "^6.2.13",
    "lucide-react": "^1.53.0",
    "next": "16.4.1",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "oauth4webapi": "3.8.8",
    "pg": "8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tar-stream": "^3.1.7",
    "use-intl": "4.14.9",
    "vaul": "^1.1.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "esdk-obs-nodejs": {
      "fast-xml-parser": "5.11.2"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar-stream": "^3.1.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "^5"
  },
  "engines": {
    "node": "24.x"
  }
}
