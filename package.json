{
  "name": "mualauncher-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "next dev",
    "prebuild": "prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "node --conditions=react-server --import tsx scripts/check-db.ts",
    "db:provision": "node --import tsx scripts/provision-database-roles.ts",
    "test:rls": "node --conditions=react-server --import tsx --test tests/rls.test.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "auth:bootstrap": "node --conditions=react-server --import tsx scripts/bootstrap-admin.ts",
    "test": "node --conditions=react-server --import tsx --test tests/core.test.ts tests/rls.test.ts tests/prisma-cache.test.ts tests/client-version.test.ts tests/client-download.test.ts tests/uploads.test.ts tests/inspection.test.ts tests/muapack.test.ts tests/muapack-v2.test.ts tests/environment.test.ts tests/modrinth.test.ts tests/forge.test.ts tests/server-probe.test.ts && npm run test:storage && npm run test:storage-telemetry && npm run test:server-motto && npm run test:package-format && npm run test:admin-ui && npm run test:openapi && npm run openapi:check",
    "test:package-format": "node --import tsx --test tests/package-format.test.ts",
    "test:admin-ui": "node --import tsx --test tests/server-management.test.tsx tests/preferences.test.tsx tests/recipe-distribution.test.tsx",
    "test:server-motto": "node --conditions=react-server --import tsx --test tests/server-motto.test.ts",
    "test:server-probe": "node --conditions=react-server --import tsx --test tests/server-probe.test.ts",
    "test:muapack": "node --conditions=react-server --import tsx --test tests/muapack.test.ts",
    "test:downloads": "node --conditions=react-server --import tsx --test tests/client-download.test.ts",
    "test:storage": "node --conditions=react-server --import tsx --test tests/object-storage.test.ts",
    "muapack:validate": "node --conditions=react-server --import tsx scripts/validate-muapack.ts",
    "typecheck": "tsc --noEmit",
    "openapi:generate": "node --import tsx scripts/openapi.ts",
    "openapi:check": "node --import tsx scripts/openapi.ts --check",
    "test:openapi": "node --import tsx --test tests/openapi.test.ts",
    "test:openapi:contracts": "node --conditions=react-server --import tsx --test --test-name-pattern=\"standard HTTP API\" tests/uploads.test.ts && npm run test:server-motto",
    "test:openapi:browser": "playwright test --config playwright.openapi.config.ts",
    "test:server-motto:browser": "playwright test --config playwright.motto.config.ts",
    "test:clients:browser": "playwright test --config playwright.clients.config.ts",
    "check:http": "node --import tsx scripts/check-http.ts",
    "storage:init": "node --conditions=react-server --import tsx scripts/initialize-storage.ts",
    "storage:verify": "node --conditions=react-server --import tsx scripts/verify-storage.ts",
    "storage:telemetry": "node --conditions=react-server --import tsx scripts/collect-storage-telemetry.ts",
    "test:storage-telemetry": "node --conditions=react-server --import tsx --test tests/storage-telemetry.test.ts",
    "worker": "node --conditions=react-server --import tsx scripts/client-worker.ts",
    "client:upload": "node --import tsx scripts/upload-client.ts",
    "runtime:sync": "node --import tsx scripts/sync-minecraft-runtime.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/s3-request-presigner": "^3.1147.0",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scalar/api-reference-react": "0.9.80",
    "@tanstack/react-table": "8.21.3",
    "ali-oss": "^6.23.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "cn": "^0.4.0",
    "cos-nodejs-sdk-v5": "^3.0.0",
    "crc-32": "^1.2.2",
    "dotenv": "18.0.6",
    "esdk-obs-nodejs": "^3.26.2",
    "lucide-react": "^1.53.0",
    "next": "16.4.0",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "tar-stream": "^3.1.7",
    "vaul": "^1.1.2",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^3.25.76"
  },
  "overrides": {
    "esdk-obs-nodejs": {
      "fast-xml-parser": "5.11.2"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@scalar/openapi-parser": "0.29.13",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/tar-stream": "^3.1.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "2.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tw-animate-css": "1.4.0",
    "typescript": "^5"
  }
}
