{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next/mua-prism/types/**/*.ts",
    ".next/mua-prism/dev/types/**/*.ts",
    ".next/mua-inspection/types/**/*.ts",
    ".next/mua-inspection/dev/types/**/*.ts",
    ".next/mua-recycle/types/**/*.ts",
    ".next/mua-recycle/dev/types/**/*.ts",
    ".next/mua-protocol/types/**/*.ts",
    ".next/mua-protocol/dev/types/**/*.ts",
    ".next/mua-packages/types/**/*.ts",
    ".next/mua-packages/dev/types/**/*.ts",
    ".next/mua-modrinth/types/**/*.ts",
    ".next/mua-modrinth/dev/types/**/*.ts",
    ".next/mua-mirrors/types/**/*.ts",
    ".next/mua-mirrors/dev/types/**/*.ts",
    ".next/mua-forge/types/**/*.ts",
    ".next/mua-forge/dev/types/**/*.ts",
    ".next/mua-pack-download/types/**/*.ts",
    ".next/mua-pack-download/dev/types/**/*.ts",
    ".next/mua-platform-defaults/types/**/*.ts",
    ".next/mua-platform-defaults/dev/types/**/*.ts",
    ".next/mua-forge-warning/types/**/*.ts",
    ".next/mua-forge-warning/dev/types/**/*.ts",
    ".next/mua-update-stats/types/**/*.ts",
    ".next/mua-update-stats/dev/types/**/*.ts",
    ".next/mua-draft-lifecycle/types/**/*.ts",
    ".next/mua-draft-lifecycle/dev/types/**/*.ts",
    ".next/mua-archived-delete/types/**/*.ts",
    ".next/mua-archived-delete/dev/types/**/*.ts",
    ".next/mua-format-choice/types/**/*.ts",
    ".next/mua-format-choice/dev/types/**/*.ts",
    ".next/mua-v2-import/types/**/*.ts",
    ".next/mua-v2-import/dev/types/**/*.ts",
    ".next/mua-v2-publish/types/**/*.ts",
    ".next/mua-v2-publish/dev/types/**/*.ts",
    ".next/mua-v2-delta/types/**/*.ts",
    ".next/mua-v2-delta/dev/types/**/*.ts",
    ".next/server-motto-test/types/**/*.ts",
    ".next/server-motto-test/dev/types/**/*.ts",
    ".next/i18n-build/types/**/*.ts",
    ".next/i18n-build/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
