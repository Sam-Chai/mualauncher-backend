DATABASE_URL="postgresql://mua_web:WEB_PASSWORD@127.0.0.1:15432/postgres"
DATABASE_AUTH_URL="postgresql://mua_auth:AUTH_PASSWORD@127.0.0.1:15432/postgres"
DATABASE_PUBLIC_URL="postgresql://mua_public:PUBLIC_PASSWORD@127.0.0.1:15432/postgres"
DATABASE_WORKER_URL="postgresql://mua_worker:WORKER_PASSWORD@127.0.0.1:15432/postgres"
DATABASE_MIGRATION_URL="postgresql://mua_migrator:MIGRATOR_PASSWORD@127.0.0.1:15432/postgres?options=-c%20role%3Dmua_owner"
# Provisioning only: supply DATABASE_ADMIN_URL temporarily, never to Web/Worker.
APP_ORIGIN="http://localhost:3000"
# minio | aws | s3 | ali | tencent | huawei; native cloud SDKs are selected by provider.
# See docs/object-storage.md for each provider. Existing S3_* config remains valid for MinIO/S3.
OSS_PROVIDER="minio"
OSS_ENDPOINT="http://127.0.0.1:9000"
OSS_REGION="us-east-1"
OSS_ACCESS_KEY_ID="minioadmin"
OSS_SECRET_ACCESS_KEY="YOUR_MINIO_PASSWORD"
OSS_PACKAGES_BUCKET="mua-packages"
OSS_CAS_BUCKET="mua-cas"
OSS_ENVIRONMENTS_BUCKET="mua-environments"
# Worker collects storage telemetry; MinIO metrics use short-lived JWT authentication.
OSS_TELEMETRY_ENABLED="true"
# Optional separate MinIO metrics origin and a read-only metrics token (server-side only).
# OSS_METRICS_ENDPOINT="http://127.0.0.1:9000"
# OSS_METRICS_BEARER_TOKEN=""
# OSS_SESSION_TOKEN="" # Optional temporary credentials; renew and restart before expiry.
# OSS_FORCE_PATH_STYLE="true" # Default true for minio/s3, false for aws/native cloud.
# OSS_CUSTOM_DOMAIN="false" # ali/huawei only; custom endpoints must contain {bucket}.
SIGNING_PRIVATE_KEY_PATH=".local/signing/dev-ed25519.pem"
FORGE_PROCESSOR_JAVA=""
# Optional trusted TLS DNS for networks with poisoned local DNS; no OS DNS changes.
DOWNLOAD_DNS_OVER_HTTPS="false"
# Backend-to-Minecraft Java status probe RTT threshold for a yellow light.
SERVER_PROBE_HIGH_LATENCY_MS="300"
